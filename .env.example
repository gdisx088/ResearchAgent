# OpenAI-compatible model with tool-calling support
OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
OPENAI_COMPATIBLE_API_KEY=your-api-key
OPENAI_COMPATIBLE_MODEL=your-model

# PaperLens remains a separately running service
PAPERLENS_BASE_URL=http://127.0.0.1:8000
PAPERLENS_WORKSPACE_ID=research-agent
PAPERLENS_RERANKER_MODE=local

# Local application
RESEARCH_AGENT_DATA_DIR=./data/runtime
RESEARCH_AGENT_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
RESEARCH_AGENT_MAX_MODEL_CALLS=40
RESEARCH_AGENT_MAX_WEB_BYTES=2000000
RESEARCH_AGENT_HTTP_TIMEOUT_SECONDS=15
RESEARCH_AGENT_DDGS_TIMEOUT_SECONDS=20
PAPERLENS_TIMEOUT_SECONDS=300
RESEARCH_AGENT_EVIDENCE_TIMEOUT_SECONDS=360
RESEARCH_AGENT_RUN_TIMEOUT_SECONDS=600
